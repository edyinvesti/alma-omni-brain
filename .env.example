# ===========================================
# Variáveis de Ambiente - ALMA System
# Copie este arquivo para .env e preencha os valores
# ===========================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_chat_id
TELEGRAM_LOCAL_POLLING=true

# --- IA APIs ---
GROQ_API_KEY=your_groq_api_key
GROQ_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_key
GEMINI_API_KEY=your_gemini_key
HF_API_KEY=your_huggingface_key

# --- Database (Turso) ---
TURSO_DATABASE_URL=your_turso_database_url
TURSO_AUTH_TOKEN=your_turso_auth_token

# --- Security ---
API_SECRET=generate_a_strong_random_key_here
HERMES_API_KEY=generate_a_strong_random_key_here

# --- Paths ---
OBSIDIAN_VAULT_PATH=C:\path\to\your\obsidian\vault
HERMES_URL=http://127.0.0.1:3001

# --- Server ---
PORT=3000
CLOUD_MODE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000