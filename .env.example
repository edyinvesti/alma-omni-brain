# ============================================
# A.L.M.A. CORE - Configuração de Variáveis
# ============================================

# === OBRIGATÓRIO ===
# Chave de segurança para API e WebSocket
# ALTERE ESTE VALOR! Não use o padrão em produção
API_SECRET=sua_chave_secreta_aqui

# === BANCO DE DADOS (Turso) ===
TURSO_DATABASE_URL=libsql://seu-banco.aws-region.turso.io
TURSO_AUTH_TOKEN=seu_token_turso

# === GROQ AI ===
# chave para Whisper (áudio) e Chat (texto)
GROQ_API_KEY=sua_chave_groq
# (opcional) alias alternativo
GROQ_KEY=sua_chave_groq

# === TELEGRAM C2 (Opcional) ===
TELEGRAM_BOT_TOKEN=seu_token_bot
TELEGRAM_ADMIN_CHAT_ID=seu_chat_id
TELEGRAM_LOCAL_POLLING=true

# === HERMES DAEMON (Opcional) ===
# URL do daemon Hermes (captura de tela, automação local)
HERMES_URL=http://127.0.0.1:3001
HERMES_API_KEY=sua_chave_hermes

# === AMBIENTE ===
CLOUD_MODE=false
# Se true, usa webhook em vez de polling
RENDER_EXTERNAL_URL=https://seu-app.onrender.com

# === SEGURANÇA ===
# Domínios autorizados (separados por vírgula)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# === PORTA ===
PORT=3000